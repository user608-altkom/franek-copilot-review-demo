{
  "name": "szkolenie-ai-rejestr-rozliczen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Repozytorium cwiczeniowe do trzydniowego szkolenia z AI w pracy programisty. Dane syntetyczne.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "raport": "tsx src/reports/dailyReport.ts dane/wyciag_2026_08.csv",
    "ksiegowanie": "tsx src/routing/silnik.ts dane/wyciag_2026_08.csv",
    "doctor": "node scripts/doctor.mjs",
    "sql:setup": "node --no-warnings scripts/sql-setup.mjs",
    "sql:raport": "node --no-warnings scripts/sql-raport.mjs",
    "pg:dump": "node --no-warnings scripts/pg-dump.mjs",
    "operator": "node --import tsx scripts/operator-server.ts",
    "operator:eksport": "node --import tsx scripts/operator-export.ts",
    "odbior": "node --import tsx scripts/odbior-final.ts",
    "operator:sql": "node --import tsx scripts/operator-sql.ts",
    "mcp:szukaj-plikow": "node --import tsx scripts/mcp-file-search-server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  }
}
